	/// Cantidad convertida a unidades individuales: 1 par = 2, 1 docena = 12, 1 millar = 1.000. Vacía cuando el despacho no informa unidad.
	column 'Cantidad Unidades'
		dataType: int64
		formatString: #,0
		lineageTag: 3fb76270-f9dd-5a5b-a576-44c85512ed29
		summarizeBy: sum
		sourceColumn: Cantidad Unidades

		annotation SummarizationSetBy = User

	/// Marca normalizada: se unificaron variantes y errores de tipeo (función fnMarca).
	column Marca
		dataType: string
		lineageTag: b917146c-64c4-4bf8-99c1-0e66697189aa
		summarizeBy: none
		sourceColumn: Marca

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isText":true}

	partition Importaciones = m
		mode: import
		queryGroup: Hechos
		source =
				let
				    // Base de datos de Softrade guardada en la carpeta del parámetro CarpetaDatos (no se publica)
				    Origen = Excel.Workbook(File.Contents(CarpetaDatos & ArchivoDatos), null, true),
				    Datos = Origen{[Item = "Tabla1", Kind = "Table"]}[Data],
				    ColumnasUtiles = Table.SelectColumns(Datos, {"Identificador", "Item", "Fecha", "NCM-SIM", "Importador", "Aduana", "Via Transporte", "País de Origen", "Pais de Procedencia", "U$S FOB", "Cantidad", "Unidad de Medida", "Marca - Sufijos"}),
				    Tipos = Table.TransformColumnTypes(ColumnasUtiles, {{"Identificador", type text}, {"Item", type text}, {"Fecha", type date}, {"NCM-SIM", type text}, {"Importador", type text}, {"Aduana", type text}, {"Via Transporte", type text}, {"País de Origen", type text}, {"Pais de Procedencia", type text}, {"U$S FOB", type number}, {"Cantidad", Int64.Type}, {"Unidad de Medida", type text}, {"Marca - Sufijos", type text}}),
				    ItemDespacho = Table.CombineColumns(Tipos, {"Identificador", "Item"}, Combiner.CombineTextByDelimiter("-", QuoteStyle.None), "Ítem Despacho"),
				    Nombres = Table.RenameColumns(ItemDespacho, {{"U$S FOB", "USD FOB"}, {"Pais de Procedencia", "País de Procedencia"}}),
				    // Normalizacion de textos con las funciones fnAduana y fnPais
				    Textos = Table.TransformColumns(Nombres, {
				        // Algunos nombres de importador traen el guion mal codificado
				        {"Importador", each Text.Replace(_, "#(00C2)#(00AD)", "-"), type text},
				        {"Aduana", fnAduana, type text},
				        {"Via Transporte", each Record.FieldOrDefault([ACUATICA = "Marítima", AVION = "Aéreo", CAMION = "Terrestre"], _, _), type text},
				        {"País de Origen", fnPais, type text},
				        {"País de Procedencia", fnPais, type text}
				    }),
				    Marca = Table.AddColumn(Textos, "Marca", each fnMarca([#"Marca - Sufijos"]), type text),
				    SinMarcaCruda = Table.RemoveColumns(Marca, {"Marca - Sufijos"}),
				    // El articulo sale de la tabla NCM: cada posicion arancelaria corresponde a un articulo
				    ConNCM = Table.NestedJoin(SinMarcaCruda, {"NCM-SIM"}, NCM, {"NCM-SIM"}, "NCM", JoinKind.LeftOuter),
				    Articulo = Table.ExpandTableColumn(ConNCM, "NCM", {"Descripcion_NCM"}, {"Artículo"}),
				    // Cantidad en unidades individuales: 1 par = 2, 1 docena = 12, 1 millar = 1.000
				    Factores = [UNIDAD = 1, PAR = 2, DOCENA = 12, MILLAR = 1000],
				    Unidades = Table.AddColumn(Articulo, "Cantidad Unidades", each
				        let Factor = Record.FieldOrDefault(Factores, [Unidad de Medida], null)
				        in if Factor = null or [Cantidad] = null then null else [Cantidad] * Factor, Int64.Type),
				    Orden = Table.ReorderColumns(Unidades, {"Ítem Despacho", "Fecha", "NCM-SIM", "Artículo", "Importador", "Aduana", "Via Transporte", "País de Origen", "País de Procedencia", "USD FOB", "Cantidad", "Unidad de Medida", "Cantidad Unidades", "Marca"}),
				    // Tipos de datos finales, explícitos para cada columna que se carga al modelo
				    TiposFinales = Table.TransformColumnTypes(Orden, {{"Ítem Despacho", type text}, {"Fecha", type date}, {"NCM-SIM", type text}, {"Artículo", type text}, {"Importador", type text}, {"Aduana", type text}, {"Via Transporte", type text}, {"País de Origen", type text}, {"País de Procedencia", type text}, {"USD FOB", type number}, {"Cantidad", Int64.Type}, {"Unidad de Medida", type text}, {"Cantidad Unidades", Int64.Type}, {"Marca", type text}})
				in
				    TiposFinales

	annotation PBI_ResultType = Table

