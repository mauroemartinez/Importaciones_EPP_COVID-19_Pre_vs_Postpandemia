/// Tabla de hechos: una fila por ítem de despacho de importación de EPP en Argentina (2018 a 2021). Fuente: Softrade.
table Importaciones
	lineageTag: 50605636-73ce-4a83-9363-44896047a44d

	/// Identificador del despacho y número de ítem.
	column 'Ítem Despacho'
		dataType: string
		lineageTag: 9bca9fcd-1744-43fd-80d8-5e3cc0574757
		summarizeBy: none
		sourceColumn: Ítem Despacho

		annotation SummarizationSetBy = User

		annotation PBI_FormatHint = {"isText":true}

	/// Fecha de oficialización del despacho. Se relaciona con Calendario.
	column Fecha
		dataType: dateTime
		isHidden
